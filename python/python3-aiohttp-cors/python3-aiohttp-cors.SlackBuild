if $(python -c 'import sphinx.pygments_styles' 2>/dev/null); then
  make -j1 -C documentation man singlehtml
  install -D -m 0644 documentation/_build/man/$SRCNAM.1 $PKG/usr/man/man1/$SRCNAM.1
  gzip -9 $PKG/usr/man/man?/*.?
fi

